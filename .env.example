# Copy to .env.local for local development, and set the same variables
# in your hosting provider (e.g. Vercel → Project → Settings → Environment Variables).

# --- Vapi webhook -----------------------------------------------------------
# Shared secret set on the Vapi assistant's Server URL (as the server secret,
# sent in `x-vapi-secret`, or as a Bearer-token credential). REQUIRED in
# production: without it the webhook rejects every request.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAPI_WEBHOOK_SECRET=

# --- MongoDB (leads + admin accounts) ---------------------------------------
# Include the database name in the URI.
MONGODB_URI=

# --- Admin dashboard --------------------------------------------------------
# Signs admin login cookies. Long random string; changing it logs everyone out.
ADMIN_SESSION_SECRET=

# --- Gemini (transcript → structured lead fields) ---------------------------
GEMINI_API_KEY=
# Optional, defaults to gemini-3.6-flash
GEMINI_MODEL=

# --- Google Sheets (lead log shared with the admissions team) ---------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service-account JSON, newlines written as \n
GOOGLE_PRIVATE_KEY=
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# Tab name, must match exactly. Defaults to "Call Logs"
GOOGLE_SHEET_NAME=

# --- Hot-lead email alerts (optional) ---------------------------------------
# When a call ends with a "Hot" lead, email the admissions team. Leave
# SMTP_HOST or ALERT_EMAIL_TO blank to turn alerts off.
# Gmail: host smtp.gmail.com, port 465, user = the Gmail address,
# pass = an App Password (Google Account → Security → App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER
ALERT_EMAIL_FROM=
# Comma-separated list of recipients
ALERT_EMAIL_TO=
# Public URL of this app, used for the "Open lead" link in alerts
# (e.g. https://riya-ai-admission-caller.vercel.app)
APP_URL=

# --- Website leads (university website → Admin → Website leads) -------------
# Shared secret the university website's backend sends as
# `Authorization: Bearer <secret>` to POST /api/website-leads. Set the SAME
# value in the website project. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBSITE_LEADS_SECRET=

# --- Outbound callbacks (optional) ------------------------------------------
# The assistant calls leads back. Needs a phone number imported into Vapi
# that can call your students (see README → Outbound callbacks).
# All three must be set, otherwise "Call now" shows as not set up.
# After deploying, Admin → Calling setup checks them live against Vapi.
# Vapi → API Keys → Private key
VAPI_API_KEY=
# Vapi → Assistants → (your assistant) → ID shown under its name
VAPI_ASSISTANT_ID=
# Vapi → Phone Numbers → (the number) → Phone Number ID (the ID, not the number)
VAPI_PHONE_NUMBER_ID=
# Added to 10-digit numbers before dialling. Defaults to 91 (India).
DEFAULT_COUNTRY_CODE=91

# Automatic daily callbacks for due follow-ups (vercel.json runs the job
# once a day, ~11 AM IST, Mon–Sat). Off unless set to true.
AUTO_CALLBACKS_ENABLED=false
# Shared secret Vercel Cron sends to /api/cron/callbacks. Required for the job.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Calling window in IST, start-end hour (default 10-19 = 10:00 to 18:59), Mon–Sat
CALLBACK_HOURS=10-19
# Max calls placed per run (default 10, max 25)
CALLBACK_BATCH_LIMIT=10
