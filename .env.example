# Copy to .env.local for local development, and set the same variables
# in your hosting provider (e.g. Vercel → Project → Settings → Environment Variables).

# --- Vapi webhook -----------------------------------------------------------
# Shared secret set on the Vapi assistant's Server URL (as the server secret,
# sent in `x-vapi-secret`, or as a Bearer-token credential). REQUIRED in
# production: without it the webhook rejects every request.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAPI_WEBHOOK_SECRET=

# --- MongoDB (leads + admin accounts) ---------------------------------------
# Include the database name in the URI.
MONGODB_URI=

# --- Admin dashboard --------------------------------------------------------
# Signs admin login cookies. Long random string; changing it logs everyone out.
ADMIN_SESSION_SECRET=

# --- Gemini (transcript → structured lead fields) ---------------------------
GEMINI_API_KEY=
# Optional, defaults to gemini-3.6-flash
GEMINI_MODEL=

# --- Google Sheets (lead log shared with the admissions team) ---------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service-account JSON, newlines written as \n
GOOGLE_PRIVATE_KEY=
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# Tab name, must match exactly. Defaults to "Call Logs"
GOOGLE_SHEET_NAME=
